# =========================================================
# Frontend
# =========================================================
skillshubdev.duckdns.org {
    encode zstd gzip

    header {
               Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
               X-Content-Type-Options "nosniff"
               Referrer-Policy "no-referrer"
           }

    @api path /api/*
    reverse_proxy @api gateway-service:8080

    reverse_proxy skillshub-frontend:80
}

# =========================================================
# API - public (Swagger backend + API Gateway)
# =========================================================
skillshubdev-api.duckdns.org {
    encode zstd gzip

    header {
               Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
               X-Content-Type-Options "nosniff"
               Referrer-Policy "no-referrer"
           }

# ----------------------------
# Swagger UI (BasicAuth)
# ----------------------------
    @swagger_ui path /swagger-ui* /swagger-resources* /webjars*
    basicauth @swagger_ui {
                          {$SWAGGER_BASIC_AUTH_USER} {$SWAGGER_BASIC_AUTH_HASH}
}

# OpenAPI JSON must be reachable by the UI
@openapi path /v3/api-docs*
              reverse_proxy @openapi backend-service:10020 {
                                                           header_up X-Forwarded-Proto https
                                                           header_up X-Forwarded-Host {host}
                                                           header_up X-Forwarded-Port 443
                                                           }

              # Swagger UI assets
              reverse_proxy @swagger_ui backend-service:10020 {
                                                              header_up X-Forwarded-Proto https
                                                              header_up X-Forwarded-Host {host}
                                                              header_up X-Forwarded-Port 443
                                                              }

              # ----------------------------
              # API Gateway (/api/*) + CORS
              # ----------------------------
              @api path /api/*

              # Preflight CORS (Swagger UI / Browser)
              @preflight {
                         method OPTIONS
                         path /api/*
                         }

              respond @preflight 204 {
                                     header Access-Control-Allow-Origin "https://skillshubdev-api.duckdns.org"
                                     header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS"
                                     header Access-Control-Allow-Headers "Authorization,Content-Type,Accept,Origin,X-Requested-With"
                                            header Access-Control-Allow-Credentials "true"
                                            header Access-Control-Max-Age "86400"
                                     header Vary "Origin"
                                     header Vary "Access-Control-Request-Method"
                                     header Vary "Access-Control-Request-Headers"
                                     }

              # CORS headers on actual API responses
              header @api {
                          Access-Control-Allow-Origin "https://skillshubdev-api.duckdns.org"
                          Access-Control-Allow-Credentials "true"
                          Vary "Origin"
                          Vary "Access-Control-Request-Method"
                          Vary "Access-Control-Request-Headers"
                          }

reverse_proxy @api gateway-service:8080

# Safety fallback (optional): anything else -> gateway
reverse_proxy gateway-service:8080
}

# =========================================================
# Grafana - public + BasicAuth au proxy
# =========================================================
skillshubdev-grafana.duckdns.org {
                                 encode zstd gzip

                                 basicauth {
        {$GRAFANA_BASIC_AUTH_USER} {$GRAFANA_BASIC_AUTH_HASH}
    }

                                 header {
                                        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                                        X-Content-Type-Options "nosniff"
                                        X-Frame-Options "SAMEORIGIN"
                                        Referrer-Policy "no-referrer"
                                        }

                                 reverse_proxy grafana:3000
                                 }

# =========================================================
# RabbitMQ UI - public + BasicAuth au proxy
# =========================================================
skillshubdev-rabbit.duckdns.org {
                                encode zstd gzip

                                basicauth {
        {$RABBIT_BASIC_AUTH_USER} {$RABBIT_BASIC_AUTH_HASH}
    }

                                header {
                                       Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                                       X-Content-Type-Options "nosniff"
                                       X-Frame-Options "SAMEORIGIN"
                                       Referrer-Policy "no-referrer"
                                       }

                                reverse_proxy rabbitmq:15672
                                }

# =========================================================
# Keycloak - public (Admin console + OIDC)
# =========================================================
skillshubdev-auth.duckdns.org {
                              encode zstd gzip

                              header {
                                     Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
                                     X-Content-Type-Options "nosniff"
                                     Referrer-Policy "no-referrer"
                                     }

                              reverse_proxy keycloak:8080 {
                                                          header_up -Forwarded
                                                          header_up X-Forwarded-Proto https
                                                          header_up X-Forwarded-Host {host}
                                                          header_up X-Forwarded-Port 443
                                                          }
}
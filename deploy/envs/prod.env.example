# Production env template (DO NOT COMMIT real prod.env with secrets)

SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=10020
SPRING_APPLICATION_NAME=backend-service

# ===========================
# Database (Course)
# ===========================
SPRING_DATASOURCE_COURSE_URL=jdbc:postgresql://postgres-course:5432/course_service
SPRING_DATASOURCE_COURSE_USERNAME=course_service_admin
SPRING_DATASOURCE_COURSE_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD_COURSE_DB>

POSTGRES_COURSE_DB=course_service
POSTGRES_COURSE_USER=course_service_admin
POSTGRES_COURSE_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD_COURSE_DB>

# ===========================
# Database (User)
# ===========================
SPRING_DATASOURCE_USER_URL=jdbc:postgresql://postgres-user:5432/user_service
SPRING_DATASOURCE_USER_USERNAME=user_service_admin
SPRING_DATASOURCE_USER_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD_USER_DB>

POSTGRES_USER_DB=user_service
POSTGRES_USER_USER=user_service_admin
POSTGRES_USER_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD_USER_DB>

# ===========================
# RabbitMQ
# ===========================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=skillshub_admin
RABBITMQ_PASS=<REPLACE_WITH_SECURE_PASSWORD_RABBITMQ>
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=course.events

RABBITMQ_DEFAULT_USER=skillshub_admin
RABBITMQ_DEFAULT_PASS=<REPLACE_WITH_SECURE_PASSWORD_RABBITMQ>

RABBITMQ_ROUTING_KEY=course.media.uploaded.v1
RABBITMQ_ROUTING_KEY_METADATA=course.media.metadata.extracted.v1
RABBITMQ_QUEUE_UPLOADED=course.media.uploaded.queue
RABBITMQ_QUEUE_METADATA=course.media.metadata.extracted.queue

RABBITMQ_VIDEO_POLLING_QUEUE=course.video.polling.queue
RABBITMQ_VIDEO_POLLING_ROUTING_KEY=course.video.polling.requested
RABBITMQ_VIDEO_POLLING_DELAY_QUEUE=course.video.polling.delay.queue
RABBITMQ_VIDEO_POLLING_DELAY_ROUTING_KEY=course.video.polling.delay
RABBITMQ_VIDEO_POLLING_TIMEOUT_MINUTES=15

# ===========================
# Video Deletion
# ===========================
VIDEO_DELETION_ENABLED=true
VIDEO_DELETION_QUEUE=course.video.deletion.queue
VIDEO_DELETION_ROUTING_KEY=course.video.deletion.requested
VIDEO_DELETION_DELAY_QUEUE=course.video.deletion.delay.queue
VIDEO_DELETION_DELAY_ROUTING_KEY=course.video.deletion.delay
VIDEO_DELETION_MAX_RETRY_ATTEMPTS=5
VIDEO_DELETION_DISPATCHER_FIXED_DELAY_MS=5000
VIDEO_DELETION_DISPATCHER_BATCH_SIZE=10

# ===========================
# Monitoring (Grafana)
# ===========================
GRAFANA_ADMIN_USER=skillshub_admin
GRAFANA_ADMIN_PASSWORD=<REPLACE_WITH_SECURE_PASSWORD_GRAFANA>

# ===========================
# Vimeo
# ===========================
VIMEO_ACCESS_TOKEN=<REPLACE_WITH_VIMEO_ACCESS_TOKEN>

# ===========================
# Internal routing
# ===========================
USER_SERVICE_BASE_URL=http://backend-service:10020